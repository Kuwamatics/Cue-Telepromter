# Port the server listens on. Hosting platforms usually set this for you.
PORT=8080

# Where the SQLite database lives. Put it on a persistent disk or volume.
CUE_DATA=./data

# Turns on the script assistant. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which model the assistant uses.
CUE_AI_MODEL=claude-sonnet-5-5

# Optional: send assistant requests through a proxy or gateway instead of api.anthropic.com.
# ANTHROPIC_BASE_URL=

# Set to 0 to stop new sign-ups once your team has joined.
CUE_ALLOW_SIGNUP=1

# Set to 1 to always mark the session cookie Secure (when your proxy doesn't send X-Forwarded-Proto).
CUE_SECURE=0
